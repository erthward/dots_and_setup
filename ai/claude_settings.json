{
  "permissions": {
    "deny": [
      "Bash(git reset:*)",
      "Bash(git rebase:*)"
    ],
    "ask": [
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash(rm:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "defaultMode": "default"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false
  },
  "theme": "auto"
}
