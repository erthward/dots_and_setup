{
  "theme": "auto",
  "permissions": {
      "defaultMode": "default",
      "ask": [
          "Edit",
          "Write",
          "NotebookEdit",
          "Bash(rm:*)"
      ],
      "deny": [
          "Bash(git commit:*)",
          "Bash(git push:*)",
          "Bash(git reset:*)",
          "Bash(git rebase:*)"
      ]
  },
  "sandbox": {
      "enabled": true,
      "autoAllowBashIfSandboxed": false,
      "allowUnsandboxedCommands": false
  }
}

